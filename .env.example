# ── Service auth & networking ────────────────────────────────────────────────
SERVICE_KEY=your_strong_random_service_key_here
REQUEST_TIMEOUT_SECONDS=20
PUBLIC_BASE_URL=https://prototype-creator.onrender.com
DEBUG=false

# ── Figma API ────────────────────────────────────────────────────────────────
FIGMA_TOKEN=your_figma_personal_access_token_here

# Default file key used when no file_key param is supplied (proxy endpoints)
# and as the LLM pipeline's default Figma file.
FIGMA_FILE_KEY=
FIGMA_FILE_KEY_2=your_figma_file_key_here

# Default node/image IDs
FIGMA_NODE_IDS=0-1
FIGMA_IMAGE_IDS=

# Image export defaults
FIGMA_DEPTH=2
FIGMA_IMAGE_FORMAT=png
FIGMA_IMAGE_SCALE=1.0

# ── SharePoint / MS Graph ────────────────────────────────────────────────────
MS_TENANT_ID=your_tenant_id
MS_CLIENT_ID=your_app_client_id
MS_CLIENT_SECRET=your_app_client_secret

SP_SITE_ID=your_sharepoint_site_id
SP_DRIVE_ID=your_sharepoint_drive_id
SP_FILE_PATH=Shared Documents/DCI Architecture Plan.xlsx
SP_FILE_PATH_EXAMPLE=Shared Documents/DCI Architecture Plan Example.xlsx
SP_WORKSHEET_NAME=Site Map

# ── Anthropic LLM (new) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── React frontend CORS (new) ────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","https://prototype-creator-ui.onrender.com"]
